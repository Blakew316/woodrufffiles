<?xml version="1.0" encoding="utf-8"?>
<!--
    The player's tvOS-style controls (layout/tv_player_controls). Media3's controller slides its
    bottom bar and time bar by these sizes as it shows and hides them; the whole layout fades
    instead, so they're zero (nothing slides, and the scrub bar keeps its own place).
-->
<resources>
    <dimen name="exo_styled_bottom_bar_height">0dp</dimen>
    <dimen name="exo_styled_progress_bar_height">0dp</dimen>
    <dimen name="exo_styled_progress_margin_bottom">0dp</dimen>

    <!-- How far the controls sit in from the sides of the screen. -->
    <dimen name="tv_player_side">80dp</dimen>

    <!-- A round glass button in the row above the scrub bar. -->
    <style name="TvPlayerButton">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/tv_player_button_bg</item>
        <item name="android:tint">@color/tv_player_icon</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/tv_player_button_focus</item>
    </style>
</resources>
