<?xml version="1.0" encoding="utf-8"?>
<!-- Player buttons: plainly visible focus (a bright ring on frosted white) instead of the
     library's faint ripple, which is nearly invisible on a TV. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#80FFFFFF" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#47FFFFFF" />
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
