<?xml version="1.0" encoding="utf-8"?>
<!-- Behind the player controls: the film darkens toward the bottom, where the title, buttons and
     scrub bar sit, and stays clear above them (as on tvOS). Dark enough behind every line of the
     controls for them to read over the brightest picture a film has (snow, a beach, a white sky):
     black 85 % at the bottom edge, 65 % halfway up (by the show's name and the buttons), clear
     320 dp up. Measured over pure white at each line's top edge: the title 9:1, the show's line
     4.9:1, the buttons' icons 4.8:1 on their glass, the times 8.3:1 (PlayerChromeContrastTest). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="bottom" android:height="320dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#A6000000"
                android:centerY="0.5"
                android:endColor="#00000000"
                android:startColor="#D9000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
