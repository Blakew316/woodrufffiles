<?xml version="1.0" encoding="utf-8"?>
<!-- Behind the player controls: the film darkens toward the bottom, where the title, buttons and
     scrub bar sit, and stays clear above them (as on tvOS). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#66000000"
        android:centerY="0.28"
        android:endColor="#00000000"
        android:startColor="#E0000000"
        android:type="linear" />
</shape>
