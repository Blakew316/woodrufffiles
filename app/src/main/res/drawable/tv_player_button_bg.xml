<?xml version="1.0" encoding="utf-8"?>
<!-- A round player button, tvOS style: frosted glass at rest, solid white when focused (the icon
     turns dark: color/tv_player_icon). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#FFD9D9DE" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#38FFFFFF" /></shape>
    </item>
</selector>
