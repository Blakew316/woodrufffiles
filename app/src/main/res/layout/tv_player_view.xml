<?xml version="1.0" encoding="utf-8"?>
<!--
    The film and its controls. The controls are Woodruff's own tvOS-style layout
    (tv_player_controls) over Media3's own controller, so seeking, the track menus and the
    remote's media keys all keep working as before.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:controller_layout_id="@layout/tv_player_controls"
    app:show_timeout="5000"
    app:previous_icon="@drawable/tv_ic_previous"
    app:next_icon="@drawable/tv_ic_next"
    app:auto_show="true"
    app:use_controller="true" />
