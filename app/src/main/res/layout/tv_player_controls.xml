<?xml version="1.0" encoding="utf-8"?>
<!--
    Player controls laid out like tvOS, kept small so the film stays the picture: what's playing
    at the bottom left, three small round buttons tucked at the far right (Subtitles, Audio, and
    "…" for speed, sleep timer and intro), and a thin scrub bar under them with the time played
    and the time left. Play, pause and seeking are the remote's. Everything sits in
    exo_center_controls, the part Media3 fades in and out; exo_controls_background is the scrim.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_scrim" />

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_player_side"
        android:paddingTop="40dp"
        android:paddingEnd="@dimen/tv_player_side"
        android:paddingBottom="26dp">

        <LinearLayout
            android:id="@+id/player_info_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_semibold"
                    android:singleLine="true"
                    android:textColor="#A6FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/interdisplay_semibold"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="22sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/player_subtitles"
                    style="@style/TvPlayerButton"
                    android:contentDescription="Subtitles"
                    android:src="@drawable/tv_ic_subtitles_off" />

                <ImageButton
                    android:id="@+id/player_audio"
                    style="@style/TvPlayerButton"
                    android:contentDescription="Audio"
                    android:src="@drawable/tv_ic_audio" />

                <ImageButton
                    android:id="@+id/player_more"
                    style="@style/TvPlayerButton"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="Speed, sleep timer and intro"
                    android:src="@drawable/tv_ic_more" />
            </LinearLayout>
        </LinearLayout>

        <com.woodruff.tvexplorer.player.TvTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</merge>
