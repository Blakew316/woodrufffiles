<?xml version="1.0" encoding="utf-8"?>
<!--
    Player controls laid out like tvOS: what's playing at the bottom left, a row of round glass
    buttons at the bottom right, and a thin scrub bar under them with the time played and the time
    left. The ids Media3 knows (exo_*) keep their jobs; Subtitles, Audio, Speed and "…" open the
    player's own menus (TvMenu). Everything sits in exo_center_controls, the
    part Media3 fades in and out; exo_controls_background is the scrim behind it.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_scrim" />

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/tv_player_side"
        android:paddingTop="40dp"
        android:paddingEnd="@dimen/tv_player_side"
        android:paddingBottom="36dp">

        <LinearLayout
            android:id="@+id/player_info_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/player_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_semibold"
                    android:singleLine="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/interdisplay_bold"
                    android:letterSpacing="-0.016"
                    android:maxLines="2"
                    android:textColor="@android:color/white"
                    android:textSize="34sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/player_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@id/exo_prev"
                    style="@style/TvPlayerButton"
                    android:contentDescription="Previous" />

                <ImageButton
                    android:id="@id/exo_next"
                    style="@style/TvPlayerButton"
                    android:contentDescription="Next" />

                <View
                    android:layout_width="14dp"
                    android:layout_height="1dp" />

                <ImageButton
                    android:id="@+id/player_subtitles"
                    style="@style/TvPlayerButton"
                    android:contentDescription="Subtitles"
                    android:src="@drawable/tv_ic_subtitles_off" />

                <ImageButton
                    android:id="@+id/player_audio"
                    style="@style/TvPlayerButton"
                    android:contentDescription="Audio"
                    android:src="@drawable/tv_ic_audio" />

                <ImageButton
                    android:id="@+id/player_speed"
                    style="@style/TvPlayerButton"
                    android:contentDescription="Playback speed"
                    android:src="@drawable/tv_ic_speed" />

                <ImageButton
                    android:id="@+id/player_more"
                    style="@style/TvPlayerButton"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="Sleep timer and intro"
                    android:src="@drawable/tv_ic_more" />
            </LinearLayout>
        </LinearLayout>

        <com.woodruff.tvexplorer.player.TvTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</merge>
