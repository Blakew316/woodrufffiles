<?xml version="1.0" encoding="utf-8"?>
<!-- A notice over other apps going: back up the way it came, quicker (TvMotion.DismissMs). A newer one arriving in its place stays above it. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:duration="180"
        android:fromYDelta="0"
        android:interpolator="@interpolator/tv_glide"
        android:toYDelta="-100%" />
    <alpha
        android:duration="180"
        android:fromAlpha="1.0"
        android:interpolator="@interpolator/tv_glide"
        android:toAlpha="0.0" />
</set>
