<?xml version="1.0" encoding="utf-8"?>
<!-- A notice over other apps arriving at the top right: glides down into place from above (its own height, TvMotion.NoticeDropPercent) as it fades in, as the in-app one does. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:duration="300"
        android:fromYDelta="-100%"
        android:interpolator="@interpolator/tv_glide"
        android:toYDelta="0" />
    <alpha
        android:duration="200"
        android:fromAlpha="0.0"
        android:interpolator="@interpolator/tv_glide"
        android:toAlpha="1.0" />
</set>
